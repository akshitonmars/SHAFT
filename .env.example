# SHAFT Environment Configuration Example
# Firebase web config is in src/lib/firebase.ts for this initial setup.
# Firebase web config values are public; protect data with Firebase Security Rules.
VITE_APP_NAME="SHAFT"
VITE_APP_TAGLINE="Build Beyond Ideas."

# GitHub OAuth App (server-side Vercel environment variables)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Custom Vercel Integration Console integration (server-side only)
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
APP_URL=https://buildatshaft.vercel.app
