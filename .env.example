# SHAFT Environment Configuration Example
# Copy this file to .env.local for local overrides.
# Do not commit real secrets or credentials.

VITE_APP_NAME="SHAFT"
VITE_APP_TAGLINE="Build Beyond Ideas."

# Supabase Auth (use the project URL and publishable/anon key; never add a service-role key here)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
